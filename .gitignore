misc
.DS_Store
.venv
firmware/.pio

# Local credentials baked in at flash time (never commit)
firmware/config/Secrets.h
# Build artifact: regenerated from data/index.html by tools/gzip_web_assets.py
firmware/data/*.gz
# Local screenshots in the repo root (not for publishing). Root-anchored so the
# tracked build photos under images/ are unaffected.
/Screenshot*.png

# Worker dependencies (server/ has its own .gitignore for the rest)
server/node_modules

# wrangler's local cache -- holds the Cloudflare account id. Left over from
# the deleted Worker; ignored so it cannot be swept into a commit.
.wrangler

# Python bytecode (tools/ + their host tests)
__pycache__/
*.pyc

# Signed firmware artifacts produced by tools/sign_firmware.sh -- never committed:
# these are build outputs, and the .bin is 1.2MB.
/dist/
