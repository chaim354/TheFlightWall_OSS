// -----------------------------------------------------------------------------
// FlightWall credentials (OPTIONAL, baked in at flash time)
//
// HOW TO USE:
//   1. Copy this file to "Secrets.h" in this same folder (firmware/config/).
//   2. Fill in your WiFi (and optionally API) credentials below.
//   3. Build + flash normally (pio run -t upload).
//
// Secrets.h is gitignored, so your credentials are NEVER committed.
// These values SEED the device on first boot; afterwards you manage everything
// from the web UI. (To re-seed after changing them, erase flash with
// `pio run -t erase` then re-upload, or change WiFi via the web UI / setup AP.)
//
// If you skip this entirely, the device boots into its "FlightWall-Setup" WiFi
// access point for browser-based setup instead.
// -----------------------------------------------------------------------------
#pragma once

#define FW_WIFI_SSID      "YourWiFiName"
#define FW_WIFI_PASSWORD  "YourWiFiPassword"

// Optional — pre-seed API credentials too (otherwise enter them in the web UI).
// Enrichment defaults to the free adsbdb.com source, so the AeroAPI key is only
// needed if you select AeroAPI (as primary or backup).
// #define FW_OPENSKY_CLIENT_ID     "your-opensky-client-id"
// #define FW_OPENSKY_CLIENT_SECRET "your-opensky-client-secret"
// #define FW_AEROAPI_KEY           "your-aeroapi-key"
